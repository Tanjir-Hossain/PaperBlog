# ---------------------------------------------------------------------------
# Base URL of the Blog Management REST API. It MUST end with "/api" because the
# service layer builds every request as `${NEXT_PUBLIC_API_URL}/auth/login`,
# `${NEXT_PUBLIC_API_URL}/blogs`, and so on.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# Origin that serves uploaded profile images. The API stores avatars under
# "/uploads/profile/..", so this is the API origin WITHOUT the "/api" suffix.
# If left blank, the app derives it from NEXT_PUBLIC_API_URL automatically.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_UPLOADS_URL=http://localhost:5000
