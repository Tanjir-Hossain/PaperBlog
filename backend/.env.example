# Copy this file to ".env" and fill in your own values.

# HTTP server
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=blogdb

# JSON Web Token
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Environment ("development" exposes the password-reset token in the API
# response so the reset flow can be tested without an email provider).
NODE_ENV=development

# Where the frontend runs — used to build the password-reset link.
FRONTEND_URL=http://localhost:3000

# Gmail credentials for sending the password-reset email (Nodemailer).
# Use a Google "App Password" (not your normal password):
#   Google Account → Security → 2-Step Verification → App passwords
# The reset email is sent in production, or in any environment once these two
# are filled in. Leave blank to keep the dev behaviour (token in the response).
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
